{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all].ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/[...all].ts"
    },
    {
      "source": "/((?!api/|uploads/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
